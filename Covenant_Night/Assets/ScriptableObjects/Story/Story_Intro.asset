  m_Script: {fileID: 11500000, guid: a4724455878f58b4791342be53e06ebc, type: 3}
  m_Name: Story_Intro
  m_EditorClassIdentifier: Assembly-CSharp::StoryBeatData
  beats:
  - heading: The Warning
    text: '"The king''s men are gathering, my lord. They come for David at dawn."


      You
      choose the covenant.'
    sprite: {fileID: 21300000, guid: 53565fcdf7fdd1441bbeb4a3b4262649, type: 3}
  - heading: The Plan
    text: '"The eastern gate. Before the sun."


      David takes up his harp and
      follows.'
    sprite: {fileID: 21300000, guid: 8e06c2766017d8847976c9f7d18aae72, type: 3}
  - heading: Slip Past the Guards
    text: 'A guard''s lantern cone shows what he sees: green, nothing. Amber, a doubt.
      Red, and he gives chase.


      Walk softly. Keep to the shadows and out of
      torchlight.'
    sprite: {fileID: 21300000, guid: 5467147b2dbde1b4885fce3ae6720510, type: 3}
  - heading: Lead David Out
    text: 'A stone thrown far off draws a guard from his post.


      Leave David
      waiting in cover while you scout, then bring him on to the golden marker.'
    sprite: {fileID: 21300000, guid: f0db8d24db82794469d3aad32d641d7b, type: 3}
