  m_Script: {fileID: 11500000, guid: a4724455878f58b4791342be53e06ebc, type: 3}
  m_Name: Story_Intro
  m_EditorClassIdentifier: Assembly-CSharp::StoryBeatData
  beats:
  - heading: The Warning
    text: 'Before midnight, a servant wakes Jonathan. "The king''s men are gathering,"
      he whispers. "They mean to take David at dawn."


      Jonathan has sworn
      a covenant with David, and he intends to keep it.'
    sprite: {fileID: 21300000, guid: 53565fcdf7fdd1441bbeb4a3b4262649, type: 3}
  - heading: The Plan
    text: 'Jonathan hurries to David''s room and wakes him. "We leave by the eastern
      gate," he says, "before the sun is up."


      David takes up his harp and
      follows.'
    sprite: {fileID: 21300000, guid: 8e06c2766017d8847976c9f7d18aae72, type: 3}
  - heading: Slipping Past the Guards
    text: 'Jonathan has trained beside these men and knows how they watch. The glow
      of a guard''s lantern shows what he can see. Green means he sees nothing, amber
      means he suspects something, and red means he is coming.


      So Jonathan
      keeps to the shadows, stays out of torchlight and walks softly.'
    sprite: {fileID: 21300000, guid: 5467147b2dbde1b4885fce3ae6720510, type: 3}
  - heading: Leading David Out
    text: 'A stone thrown into the dark will draw a guard away from his post.


      David
      waits in cover while Jonathan scouts ahead. When the way is clear, Jonathan
      brings him on to the next golden marker.'
    sprite: {fileID: 21300000, guid: f0db8d24db82794469d3aad32d641d7b, type: 3}
